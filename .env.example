# ============================================================
# Location Analyzer v2 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to version control!
# ============================================================

# --- Database ---
# Development (SQLite - default)
DATABASE_URL=sqlite:///./data/location_analyzer.db

# Production (PostgreSQL - uncomment and fill in)
# DATABASE_URL=postgresql://user:password@localhost:5432/location_analyzer

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_CORS_ORIGINS=["*"]

# --- Scraping ---
# Request throttling (seconds, random between min and max)
SCRAPER_MIN_DELAY=2.0
SCRAPER_MAX_DELAY=8.0
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30

# Rotating proxy for Doogal only (avg_household_income). Comma-separated list.
# Supports: http://user:pass@host:port  or  host:port:user:pass (e.g. gb.decodo.com:30000:user:pass)
# SCRAPER_DOOGAL_PROXIES=http://user:password@proxy.example.com:3128
# SCRAPER_DOOGAL_PROXIES=gb.decodo.com:30000:username:password
# Doogal tab timing (tune if needed). With proxy: ~4–6s load, ~6–8s for content.
# SCRAPER_DOOGAL_GOTO_TIMEOUT_MS=45000
# SCRAPER_DOOGAL_WAIT_AFTER_LOAD_MS=8000
# SCRAPER_DOOGAL_RETRIES=2
# SCRAPER_DOOGAL_RETRY_DELAY_SEC=10

# Browser mode
SCRAPER_HEADLESS=true

# --- ML ---
ML_MODELS_DIR=models
ML_DEFAULT_METRIC=rmse

# --- Paths ---
DATA_DIR=data
DEMOGRAPHIC_DATA_DIR=data/demographic_data
OUTPUT_DIR=data/output
CACHE_DIR=data/cache
PLOTS_DIR=data/plots

# --- ngrok (development) ---
# NGROK_AUTH_TOKEN=your_token_here
# NGROK_DOMAIN=your-domain.ngrok-free.app

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/location_analyzer.log
